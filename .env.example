APP_NAME=Hotezo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=base64:CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_KEY
APP_TIMEZONE=Asia/Kolkata

SESSION_NAME=hotezo_session
SESSION_LIFETIME=120

# Optional: fixed Super Admin credentials for `php cli seed` (otherwise a random
# password is generated and printed once). Rate-limiting/remember-me defaults below.
SUPER_ADMIN_EMAIL=admin@hotezo.com
SUPER_ADMIN_PASSWORD=
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REMEMBER_DAYS=30

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotezo
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@hotezo.com
MAIL_FROM_NAME="Hotezo"
