# local | production. Also the default for APP_FORCE_HTTPS below
# (force on for everything except local) and Session's use of it is
# indirect via SESSION_NAME/SESSION_LIFETIME only — APP_ENV itself
# doesn't change DB/mail behavior.
APP_NAME=Hotezo
APP_ENV=local
# NEVER true in production — a stack trace on a live site leaks file
# paths, config values, and query structure to anyone who can 500 it.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=base64:CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_KEY
APP_TIMEZONE=Asia/Kolkata

# Redirects HTTP -> HTTPS (see config/app.php). Defaults to true
# whenever APP_ENV != local, so this is normally left unset. Set it to
# false temporarily on a fresh production deploy if SSL isn't
# provisioned yet (Hostinger's free SSL can take a few minutes to
# activate after pointing a domain) — flipping it on too early there
# would make the site unreachable until the cert is live.
APP_FORCE_HTTPS=

SESSION_NAME=hotezo_session
# Minutes. Also the browser cookie's lifetime — see App\Core\Session.

# Powers the landing page's Live Demo quick-login cards (POST /demo-login).
# Keep false in production — leave it off until you actually want strangers
# able to one-click into a Super Admin session (see database/seeders/DemoUsersSeeder.php).
DEMO_MODE=true

# Neither route exists yet — see config/app.php. Leave both false; the
# landing page falls back to /login and a mailto: link respectively.
REGISTER_ENABLED=
CONTACT_PAGE_ENABLED=
MARKETING_CONTACT_EMAIL=hello@hotezo.com

# Optional: fixed Super Admin credentials for `php cli seed` (otherwise a random
# password is generated and printed once). Rate-limiting/remember-me defaults below.
SUPER_ADMIN_EMAIL=admin@hotezo.com
SUPER_ADMIN_PASSWORD=
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REMEMBER_DAYS=30

# Local (XAMPP) defaults below. On Hostinger, hPanel -> Databases gives
# you a dedicated DB name/user/password (usually u123456789_something)
# and DB_HOST is typically localhost — never reuse the XAMPP root/blank
# credentials against a real deployment.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotezo
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@hotezo.com
MAIL_FROM_NAME="Hotezo"
